{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cerdas-amat",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../client/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"],
  },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "ratelimits": [
    {
      "name": "CREATE_ROOM_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 },
    },
    { "name": "JOIN_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
  ],
  "observability": { "enabled": true },
  "routes": [{ "pattern": "cerdas-amat.radlabs.my.id", "custom_domain": true }],
  "env": {
    // Binding durable_objects dan ratelimits tidak diwariskan ke env, jadi diulang di sini.
    "preview": {
      "workers_dev": true,
      "routes": [],
      "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] },
      "ratelimits": [
        {
          "name": "CREATE_ROOM_LIMIT",
          "namespace_id": "1001",
          "simple": { "limit": 20, "period": 60 },
        },
        { "name": "JOIN_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
      ],
    },
  },
}
